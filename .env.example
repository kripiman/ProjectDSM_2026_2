# Copie este archivo como ".env" y ajuste los valores. Nunca suba el ".env" real al repositorio.
# Los valores de JWT_SECRET y ADMIN_PASSWORD son de ejemplo: el servidor se niega a arrancar
# en producción (NODE_ENV=production) mientras conserven el valor de esta plantilla.

# --- Servidor ---------------------------------------------------------------
PORT=8080
# development | production | test
NODE_ENV=development
# En desarrollo se imprimen las sentencias SQL; use false para silenciarlas (true las activa en otros entornos).
LOG_SQL=true

# --- Base de datos (SQLite) ---------------------------------------------------
DATABASE_STORAGE=./rock.sqlite

# --- Seguridad ----------------------------------------------------------------
# Clave de firma de los tokens JWT. En producción es obligatoria y debe tener al
# menos 32 caracteres. Genere una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reemplace_por_una_clave_larga_y_aleatoria
# Vigencia de los tokens: 30d, 12h, ... o un número de segundos.
JWT_EXPIRES_IN=30d
# Costo del hash de contraseñas.
BCRYPT_ROUNDS=10

# --- Usuario administrador inicial ---------------------------------------------
# Se crea al inicializar la base de datos (npm run db:init / db:seed / npm start).
# Si se dejan vacíos no se crea ningún administrador. La contraseña requiere 8+ caracteres.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambie_esta_contrasena
ADMIN_NAME=Administrador

# --- Reconocimiento de rocas --------------------------------------------------
# API GeoDex (la clave se solicita por invitación en <GEODEX_API_URL>/signup).
# Sin clave se usa el clasificador heurístico local. La clave del proyecto tiene una cuota
# de 50 consultas por día (se renueva a las 00:00 UTC): una foto repetida se responde desde
# memoria y, agotada la cuota, el sistema sigue con el clasificador local.
GEODEX_API_URL=https://geodex-ml-api-76365064073.southamerica-west1.run.app
GEODEX_API_KEY=
# Una consulta tarda entre 5 y 15 segundos; con menos de 10000 puede abortarse una
# consulta que el servicio igualmente descuenta de la cuota.
GEODEX_TIMEOUT_MS=30000

# Microservicio ML local opcional (vacío = deshabilitado)
ML_SERVER_URL=
ML_TIMEOUT_MS=4000

# Adjudicador asistido opcional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Archivos subidos ---------------------------------------------------------
UPLOAD_DIR=uploads/analyses
SPECIMEN_UPLOAD_DIR=uploads/specimens
