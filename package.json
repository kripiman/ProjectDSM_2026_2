{
  "name": "projectdsm_2026_2",
  "version": "0.9.0",
  "description": "backend de la app de rocas",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --forceExit",
    "db:init": "node src/database/init.js",
    "db:reset": "node src/database/init.js --force",
    "db:seed": "node src/database/init.js --seed",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status"
  },
  "author": "Gabriel Piñones",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 20000
  }
}
